<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window behind Compose; everything visible is styled in ui/theme/. -->
    <style name="Theme.Dotlink" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Dotlink.Translucent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <color name="window_background">#FFF2F2F2</color>
    <color name="launcher_background">#FF000000</color>
</resources>
